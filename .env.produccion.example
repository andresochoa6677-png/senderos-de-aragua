# ============================================================================
# Senderos de Aragua — Variables de PRODUCCIÓN (plantilla)
#
# CÓMO USARLA (en el VPS):
#   1. sudo mkdir -p /opt/senderos
#   2. sudo cp <repo>/.env.produccion.example /opt/senderos/senderos.env
#   3. sudo nano /opt/senderos/senderos.env   ← llenar TODOS los CHANGE_ME
#   4. sudo chmod 600 /opt/senderos/senderos.env
#   5. sudo bash scripts/desplegar-vps.sh
#
# El script desplegar-vps.sh:
#   - NO sobrescribe /opt/senderos/senderos.env si ya existe.
#   - ABORTA si queda algún valor CHANGE_ME.
#   - Usa este archivo como ÚNICA fuente de variables (MySQL + backend).
#
# Seguridad:
#   - Genera contraseñas largas y únicas, p. ej.:
#       openssl rand -base64 24
#   - NUNCA versiones este archivo lleno ni reutilices claves de desarrollo.
#   - MYSQL_PORT va atado a 127.0.0.1: MySQL solo es accesible dentro del VPS.
# ============================================================================

# --- Spring -----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
# El backend solo escucha en loopback (Nginx es la única puerta de entrada).
SERVER_ADDRESS=127.0.0.1

# --- MySQL (contenedor Docker; usa docker/docker-compose.yml) ---------------
# Base de datos y usuario de aplicación (el backend solo necesita estos).
MYSQL_DATABASE=senderos
MYSQL_USER=senderos
MYSQL_PASSWORD=CHANGE_ME_contrasena_aplicacion
# Root del contenedor: SOLO para administración (backups usan el usuario app).
MYSQL_ROOT_PASSWORD=CHANGE_ME_contrasena_root
# ⚠ Escuchar SOLO en loopback del VPS. No cambiar a 3306: quedaría público.
MYSQL_PORT=127.0.0.1:3306

# --- Conexión del backend a la BD (debe coincidir con MYSQL_*) --------------
DB_URL=jdbc:mysql://127.0.0.1:3306/senderos
DB_USERNAME=senderos
# ⚠ Debe ser EXACTAMENTE la misma que MYSQL_PASSWORD (el script la valida).
DB_PASSWORD=CHANGE_ME_contrasena_aplicacion

# --- Correo (Brevo) ----------------------------------------------------------
# Modo activo: plantillas de Brevo vía API v3 (BrevoApiEmailService).
MAIL_MODO=brevo
# Clave de API de Brevo (prefijo xkeysib-… — NO la key SMTP xsmtpsib-).
# Dashboard Brevo → SMTP & API → API Keys.
BREVO_API_KEY=CHANGE_ME_xkeysib_clave_api
# Plantillas ya creadas en el dashboard (1=verificación, 2=recuperación).
BREVO_TEMPLATE_VERIFICACION=1
BREVO_TEMPLATE_RECUPERACION=2
# Respaldo SMTP (solo se usa si MAIL_MODO=smtp; el perfil prod exige las vars).
MAIL_HOST=smtp-relay.sendinblue.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_usuario_smtp_brevo
MAIL_PASSWORD=CHANGE_ME_key_smtp_brevo
# Remitente visible de los correos. OJO:
#   - MIENTRAS el dominio miespacioeco.com no esté autenticado en Brevo
#     (SPF/DKIM/DMARC) y el remitente no-reply@… validado, deja el remitente
#     actual (andresochoa224@unisangil.edu.co) para no romper los envíos.
#   - Cuando Brevo valide el dominio, cambia a no-reply@miespacioeco.com.
MAIL_FROM=CHANGE_ME_remitente_validado_en_brevo
MAIL_FROM_NAME="Senderos de Aragua"

# --- URL pública y seguridad -------------------------------------------------
# Base de los enlaces de verificación/recuperación que van en los correos.
APP_BASE_URL=https://miespacioeco.com
# Origen permitido por CORS (el frontend se sirve del mismo dominio vía Nginx).
CORS_ALLOWED_ORIGINS=https://miespacioeco.com
# Cookies de sesión solo por HTTPS (el perfil prod además lo fuerza).
COOKIE_SECURE=true
# Rate limiting de endpoints públicos (por defecto 10 intentos / 10 minutos).
RATE_LIMIT_MAX_INTENTOS=10
RATE_LIMIT_VENTANA_MINUTOS=10
# Borrado de cuentas PENDIENTE sin verificar (días).
LIMPIEZA_DIAS_PENDIENTE=7

# --- Despliegue (usadas por desplegar-vps.sh) --------------------------------
# Correo de contacto para el certificado Let's Encrypt (avisos de renovación).
CERTBOT_EMAIL=CHANGE_ME_correo_para_certificado
# Opcional: deja en true para PROBAR certbot con el entorno de prueba de
# Let's Encrypt (sin límites de tasa). Al pasar a producción, quita la línea
# o ponla en false y re-ejecuta el script para el certificado real.
# CERTBOT_STAGING=false
