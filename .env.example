# ============================================================
# Senderos de Aragua - Variables de entorno (PLANTILLA)
# Copia este archivo a .env y ajusta los valores.
# NUNCA subas .env a Git (ya está ignorado por .gitignore).
# ============================================================

# --- MySQL (docker compose) ---
MYSQL_DATABASE=senderos
MYSQL_USER=senderos
MYSQL_PASSWORD=cambia-esta-clave
MYSQL_ROOT_PASSWORD=cambia-esta-root-clave
MYSQL_PORT=3306

# --- Backend (Spring Boot) ---
# Corresponde a spring.datasource.* cuando usas el perfil 'local'
DB_URL=jdbc:mysql://localhost:3306/senderos
DB_USERNAME=senderos
DB_PASSWORD=cambia-esta-clave

# Semillas de cuentas iniciales (solo primer arranque).
# Si dejas vacío ADMIN_PASSWORD o DEMO_PASSWORD, se genera una
# contraseña aleatoria y se imprime UNA VEZ en el log de arranque.
ADMIN_EMAIL=admin@senderos.local
ADMIN_PASSWORD=
DEMO_EMAIL=demo@senderos.local
DEMO_PASSWORD=

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8080

# --- Correo (verificación y recuperación) ---
# MAIL_MODO: captura (dev/test; guarda correos en backend/correo-saliente/)
#            o smtp (produccion; envio real con los valores de abajo).
MAIL_MODO=captura
MAIL_HOST=smtp.tu-proveedor.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@tudominio.com
MAIL_PASSWORD=cambia-esta-clave-smtp
MAIL_FROM=no-reply@tudominio.com
MAIL_FROM_NAME=Senderos de Aragua
# URL publica del frontend (base de los enlaces de correo):
APP_BASE_URL=http://localhost:5173
